%% thesisextras.sty — aparato didático da dissertação
%% Caixas de resumo de capítulo, publicação associada e transição,
%% seguindo os padrões do guia (docs/guia-escrita-didatica.md; modelos:
%% Grinsztajn 2024, Hutter 2009). Implementação leve (sem tcolorbox,
%% para compatibilidade com a classe risethesis de 2012).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{thesisextras}[2026/10/05 Didactic boxes for the thesis]

\RequirePackage{xcolor}
\RequirePackage{framed}

\definecolor{boxrule}{HTML}{2A78D6}
\definecolor{boxbg}{HTML}{F2F6FC}
\definecolor{transrule}{HTML}{008300}
\definecolor{transbg}{HTML}{F2F8F2}

%% Resumo do capítulo (abertura): \resumocapitulo{texto}
\newenvironment{resumocapitulo}{%
  \def\FrameCommand{{\color{boxrule}\vrule width 2.5pt}\hspace{6pt}%
    \colorbox{boxbg}}%
  \MakeFramed{\advance\hsize-\width\FrameRestore}%
  \noindent\textbf{Resumo do capítulo.}\ }%
  {\endMakeFramed}

%% Publicação/material associado: \publicacaoassociada{texto}
\newcommand{\publicacaoassociada}[1]{%
  \begin{quote}\small\textbf{Material associado.}\ #1\end{quote}}

%% Transição para o próximo capítulo (fechamento): \begin{transicao}...\end{transicao}
\newenvironment{transicao}{%
  \def\FrameCommand{{\color{transrule}\vrule width 2.5pt}\hspace{6pt}%
    \colorbox{transbg}}%
  \MakeFramed{\advance\hsize-\width\FrameRestore}%
  \noindent\textbf{Transição.}\ }%
  {\endMakeFramed}

%% Achado destacado nos capítulos de resultados: \achado{n}{texto}
\newcommand{\achado}[2]{\paragraph*{Achado #1.\ \textit{#2}}}
\endinput
